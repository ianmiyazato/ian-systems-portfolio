{
  "name": "ian-systems-portfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "turbo dev --filter=@portfolio/shell",
    "dev:all": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "check": "corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm build",
    "screenshots": "playwright test --project=screenshots",
    "e2e": "playwright test --project=chromium",
    "deploy:all": "bash scripts/deploy-all.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@next/eslint-plugin-next": "15.5.26",
    "@playwright/test": "1.55.0",
    "@types/node": "22.18.6",
    "@typescript-eslint/eslint-plugin": "8.44.1",
    "@typescript-eslint/parser": "8.44.1",
    "eslint": "9.36.0",
    "eslint-config-next": "15.5.26",
    "pnpm": "10.17.1",
    "prettier": "3.6.2",
    "turbo": "2.8.12",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
