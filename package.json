{
  "name": "ian-systems-portfolio",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "turbo dev --filter=./apps/*",
    "dev:all": "turbo dev --filter=./apps/*",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "check": "corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm build",
    "screenshots": "playwright test --project=screenshots",
    "e2e": "playwright test --project=chromium",
    "deploy:all": "bash scripts/deploy-all.sh",
    "dev:shell": "turbo dev --filter=@portfolio/shell",
    "deploy:prod": "bash scripts/deploy-all.sh --prod",
    "lighthouse": "node scripts/lighthouse.mjs",
    "lighthouse:ci": "lhci autorun --config=lighthouserc.cjs",
    "verify:route": "node scripts/verify-route.mjs",
    "shots": "node scripts/shots.mjs",
    "budget": "node scripts/budget.mjs",
    "js:budget": "playwright test tests/e2e/budgets.spec.ts --project=chromium --workers=1",
    "contracts": "WRITE_CONTRACTS=${WRITE_CONTRACTS:-} corepack pnpm --filter @portfolio/events exec vitest run src/compat.test.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@lhci/cli": "0.15.1",
    "@next/eslint-plugin-next": "15.5.26",
    "@playwright/test": "1.55.0",
    "@types/node": "22.18.6",
    "@typescript-eslint/eslint-plugin": "8.44.1",
    "@typescript-eslint/parser": "8.44.1",
    "eslint": "9.36.0",
    "eslint-config-next": "15.5.26",
    "lighthouse": "12.6.1",
    "pnpm": "10.17.1",
    "prettier": "3.6.2",
    "turbo": "2.8.12",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
