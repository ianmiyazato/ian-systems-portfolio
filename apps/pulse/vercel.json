{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "sveltekit",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm run build --filter=@portfolio/pulse...",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- ../../apps/pulse ../../packages ../../decisions ../../pnpm-lock.yaml",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "develop": false,
      "feat/**": false,
      "fix/**": false,
      "docs/**": false,
      "chore/**": false
    }
  }
}
