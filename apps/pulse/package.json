    "@portfolio/remote-runtime": "workspace:*",
    "@portfolio/tokens": "workspace:*",
    "@sveltejs/adapter-vercel": "6.3.4",
    "@sveltejs/kit": "2.43.1",
    "@sveltejs/vite-plugin-svelte": "6.2.0",
    "svelte": "5.39.6",
    "vite": "7.1.7"
  },
  "devDependencies": {
    "svelte-check": "4.3.2"
