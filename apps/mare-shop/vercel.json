{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm run build --filter=@portfolio/mare-shop...",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- ../../apps/mare-shop ../../packages ../../decisions ../../pnpm-lock.yaml",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/mare/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "develop": false,
      "feat/**": false,
      "fix/**": false,
      "docs/**": false,
      "chore/**": false
    }
  }
}
