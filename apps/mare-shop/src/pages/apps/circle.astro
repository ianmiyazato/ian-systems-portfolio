---
import '@portfolio/tokens/fonts/circle';
import '../../styles/apps.css';
import '../../styles/shop.css';
import Zone from '../../layouts/Zone.astro';
import Phone from '../../components/Phone.astro';
import AppsHeader from '../../components/apps/AppsHeader.astro';
import Screens from '../../components/apps/CreatorScreens.astro';
const phones = [['Earnings', 0], ['Campaign brief', 1], ['Payouts', 2]] as const;
const anchors = ['app-circle-0', 'app-circle-1', 'app-circle-2'];
---
<Zone title="Circle creator app · Maré" description="What creators see: earnings with the return window spelled out, a brief worth joining, and money that flows on a schedule." context="Maré · Apps" theme="circle">
  <main class="apps">
    <AppsHeader kicker="Maré apps · three interactive screens" title="Circle creator app" current="circle">What creators see: earnings with the return window spelled out, a brief worth joining, and money that flows on a schedule. Swipe inside any phone, or use the dots.</AppsHeader>
    <div class="phones">
      {phones.map(([label, start], index) => (
        <div class="phone-wrap">
          <Phone label={`${label} screen`} anchor={anchors[index]}><Screens start={start} /></Phone>
          <p class="phone-caption">{label}</p>
        </div>
      ))}
    </div>
  </main>
  <script>
    import '../../scripts/phones';
  </script>
</Zone>
