---
import '@portfolio/tokens/fonts/consumer';
import '../../styles/apps.css';
import '../../styles/shop.css';
import Zone from '../../layouts/Zone.astro';
import Phone from '../../components/Phone.astro';
import AppsHeader from '../../components/apps/AppsHeader.astro';
import Screens from '../../components/apps/ShopScreens.astro';
const phones = [['Home', 0], ['Product', 1], ['Order tracking', 2]] as const;
const anchors = ['app-shop-0', 'app-shop-1', 'app-shop-2'];
---
<Zone title="Shopping app · Maré" description="AI search that types, a product page that knows your store, and a courier you can watch." context="Maré · Apps" theme="consumer">
  <main class="apps">
    <AppsHeader kicker="Maré apps · three interactive screens" title="Shopping app" current="shop">AI search that types, a product page that knows your store, and a courier you can watch. Swipe inside any phone, or use the dots.</AppsHeader>
    <div class="phones">
      {phones.map(([label, start], index) => (
        <div class="phone-wrap">
          <Phone label={`${label} screen`} anchor={anchors[index]}><Screens start={start} /></Phone>
          <p class="phone-caption">{label}</p>
        </div>
      ))}
    </div>
  </main>
  <script>
    import '../../scripts/phones';
  </script>
</Zone>
