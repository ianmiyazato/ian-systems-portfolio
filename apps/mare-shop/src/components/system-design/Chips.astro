---
import { deck } from '@portfolio/system-design';
---
<div class="sdp-chips" data-anchor="sd-chips" data-present-steps="1">
  <ul>
    {deck.chips.items.map((chip) => <li><strong>{chip.value}</strong><span>{chip.text.replace(chip.value, '').trim()}</span></li>)}
  </ul>
  <p class="sdp-illustrative">{deck.chips.label}</p>
</div>
