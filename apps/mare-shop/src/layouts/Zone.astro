---
import '@portfolio/tokens/styles.css';
import '@portfolio/tokens/fonts/consumer';

interface Props { title: string; description: string; context: string; theme?: string; lang?: string }
const { title, description, context, theme = 'consumer', lang = 'pt-BR' } = Astro.props;
---
<!doctype html>
<html lang={lang} data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F7F4F0" />
  </head>
  <body>
    <im-portfolio-bar context={context}></im-portfolio-bar>
    <slot />
    <footer class="im-footer">All names are fictitious · data is synthetic · AI behavior is simulated in v0.1</footer>
    <im-decision-lens></im-decision-lens>
    <im-command-palette></im-command-palette>
    <script>
      import { defineChrome } from '@portfolio/chrome';
      defineChrome();
    </script>
  </body>
</html>
