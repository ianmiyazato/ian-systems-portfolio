{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": ["AI_MODE", "DATA_MODE", "NEXT_PUBLIC_AI_MODE", "NEXT_PUBLIC_DATA_MODE"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", ".svelte-kit/output/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  }
}
