{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mare.example/schemas/orders.placed",
  "title": "orders.placed",
  "description": "An order was placed. v3: no fulfillment type (pickup vs delivery was inferred from the store).",
  "type": "object",
  "required": [
    "id",
    "topic",
    "at",
    "key",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "topic": {
      "const": "orders.placed"
    },
    "at": {
      "type": "string"
    },
    "key": {
      "type": "string"
    },
    "payload": {
      "type": "object",
      "required": [
        "orderId",
        "channel",
        "store",
        "customer",
        "items",
        "totalCents",
        "payment"
      ],
      "additionalProperties": false,
      "properties": {
        "orderId": {
          "type": "string"
        },
        "channel": {
          "type": "string",
          "enum": [
            "site",
            "app",
            "store",
            "marketplace"
          ]
        },
        "store": {
          "type": "string",
          "pattern": "^#\\d{4}$"
        },
        "customer": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "sku",
              "name",
              "size",
              "priceCents"
            ],
            "additionalProperties": false,
            "properties": {
              "sku": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "size": {
                "type": "string"
              },
              "priceCents": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "totalCents": {
          "type": "integer",
          "minimum": 0
        },
        "payment": {
          "type": "string",
          "enum": [
            "pix",
            "card",
            "pay-credit",
            "pay-store"
          ]
        }
      }
    }
  }
}
