{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mare.example/schemas/delivery.updated",
  "title": "delivery.updated",
  "description": "A carrier reported progress on a delivery.",
  "type": "object",
  "required": [
    "id",
    "topic",
    "at",
    "key",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "topic": {
      "const": "delivery.updated"
    },
    "at": {
      "type": "string"
    },
    "key": {
      "type": "string"
    },
    "payload": {
      "type": "object",
      "required": [
        "orderId",
        "carrier",
        "status",
        "etaMinutes"
      ],
      "additionalProperties": false,
      "properties": {
        "orderId": {
          "type": "string"
        },
        "carrier": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "label-created",
            "picked-up",
            "in-transit",
            "out-for-delivery",
            "delivered"
          ]
        },
        "etaMinutes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
