{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mare.example/schemas/price.changed",
  "title": "price.changed",
  "description": "A price change was approved (by a person, or an agent proposal a person approved).",
  "type": "object",
  "required": [
    "id",
    "topic",
    "at",
    "key",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "topic": {
      "const": "price.changed"
    },
    "at": {
      "type": "string"
    },
    "key": {
      "type": "string"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sku",
        "name",
        "fromCents",
        "toCents",
        "channels",
        "source",
        "approvedBy",
        "reason",
        "untilDays"
      ],
      "properties": {
        "sku": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "fromCents": {
          "type": "integer",
          "minimum": 0
        },
        "toCents": {
          "type": "integer",
          "minimum": 0
        },
        "channels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "site",
              "app",
              "marketplace"
            ]
          }
        },
        "source": {
          "type": "string",
          "enum": [
            "agent",
            "human"
          ]
        },
        "model": {
          "type": "string"
        },
        "approvedBy": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "untilDays": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
