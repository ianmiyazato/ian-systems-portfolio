{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mare.example/schemas/returns.created",
  "title": "returns.created",
  "description": "A customer started a return.",
  "type": "object",
  "required": [
    "id",
    "topic",
    "at",
    "key",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "topic": {
      "const": "returns.created"
    },
    "at": {
      "type": "string"
    },
    "key": {
      "type": "string"
    },
    "payload": {
      "type": "object",
      "required": [
        "returnId",
        "orderId",
        "store",
        "channel",
        "sku",
        "name",
        "size",
        "reason",
        "amountCents",
        "customer"
      ],
      "additionalProperties": false,
      "properties": {
        "returnId": {
          "type": "string"
        },
        "orderId": {
          "type": "string"
        },
        "store": {
          "type": "string",
          "pattern": "^#\\d{4}$"
        },
        "channel": {
          "type": "string",
          "enum": [
            "in-store",
            "courier"
          ]
        },
        "sku": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "size": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "enum": [
            "size",
            "changed-mind",
            "damaged",
            "not-as-pictured",
            "late"
          ]
        },
        "amountCents": {
          "type": "integer",
          "minimum": 0
        },
        "customer": {
          "type": "string"
        }
      }
    }
  }
}
