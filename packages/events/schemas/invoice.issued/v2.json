{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mare.example/schemas/invoice.issued",
  "title": "invoice.issued",
  "description": "An e-invoice was authorized or rejected by the tax gateway.",
  "type": "object",
  "required": [
    "id",
    "topic",
    "at",
    "key",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "topic": {
      "const": "invoice.issued"
    },
    "at": {
      "type": "string"
    },
    "key": {
      "type": "string"
    },
    "payload": {
      "type": "object",
      "required": [
        "orderId",
        "invoice",
        "status",
        "ncm"
      ],
      "additionalProperties": false,
      "properties": {
        "orderId": {
          "type": "string"
        },
        "invoice": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "authorized",
            "rejected"
          ]
        },
        "rejectionCode": {
          "type": "string"
        },
        "ncm": {
          "type": "string"
        }
      }
    }
  }
}
