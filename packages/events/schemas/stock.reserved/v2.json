{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mare.example/schemas/stock.reserved",
  "title": "stock.reserved",
  "description": "Units were reserved for an order at a store.",
  "type": "object",
  "required": [
    "id",
    "topic",
    "at",
    "key",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "topic": {
      "const": "stock.reserved"
    },
    "at": {
      "type": "string"
    },
    "key": {
      "type": "string"
    },
    "payload": {
      "type": "object",
      "required": [
        "orderId",
        "sku",
        "size",
        "store",
        "quantity",
        "remaining"
      ],
      "additionalProperties": false,
      "properties": {
        "orderId": {
          "type": "string"
        },
        "sku": {
          "type": "string"
        },
        "size": {
          "type": "string"
        },
        "store": {
          "type": "string",
          "pattern": "^#\\d{4}$"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        },
        "remaining": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
