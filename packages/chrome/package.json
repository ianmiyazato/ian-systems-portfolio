{
  "name": "@portfolio/chrome",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "default": "./dist/registry.js"
    },
    "./now-playing": {
      "types": "./dist/now-playing-store.d.ts",
      "default": "./dist/now-playing.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@portfolio/ai-sim": "workspace:*",
    "@portfolio/routes": "workspace:*",
    "@portfolio/tokens": "workspace:*",
    "@portfolio/world": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.9.2",
    "vite": "7.1.7",
    "vitest": "3.2.4"
  }
}
